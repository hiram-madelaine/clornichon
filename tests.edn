#kaocha/v1
 {:tests           [{:id                             :scenario
                     :type                           :kaocha.type/scenari
                     :kaocha/source-paths            ["src"]
                     :kaocha/test-paths              ["test/scenari/v2"]
                     :kaocha.type.scenari/glue-paths ["scenari/v2"]}

                    {:id                      :unit
                     :type                    :kaocha.type/clojure.test
                     :source-paths            ["src"]
                     :test-paths              ["test"]
                     :ns-patterns             ["scenari.*-test"]
                     :kaocha.filter/skip-meta [:scenari/feature-test :integration]}]
  :kaocha/reporter kaocha.report/documentation

  ;; CI reads target/junit.xml; profiling comes first because junit-xml
  ;; takes each testcase's time= from :kaocha.plugin.profiling/duration,
  ;; and reports 0.000000 everywhere without it.
  ;; kaocha picks the :ci profile only when CI is exactly "true" (GitHub
  ;; Actions and GitLab set it that way, Jenkins does not).
  ;; les profils ne fusionnent pas : scenari-tags, qui apporte `--tags`, doit
  ;; être listé dans les deux
  ;; scenari-doc (`--doc-html`) et scenari-dry-run (`--dry-run`) viennent
  ;; après scenari-tags : ils lisent le test-plan une fois filtré
  :kaocha/plugins  #profile {:default [:kaocha.plugin/scenari-tags
                                       :kaocha.plugin/scenari-doc
                                       :kaocha.plugin/scenari-dry-run]
                             :ci      [:kaocha.plugin/scenari-tags
                                       :kaocha.plugin/scenari-doc
                                       :kaocha.plugin/scenari-dry-run
                                       :kaocha.plugin/profiling
                                       :kaocha.plugin/junit-xml]}
  :kaocha.plugin.junit-xml/target-file "target/junit.xml"}
